@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="sign-in-panel">
    <p class="eyebrow">Employee access</p>
    <h1>Sign in</h1>
    <p>
        Sign in with your employee account to open a module.
        Until sign-in is completed, AeroLink will not show operational information or module functions.
    </p>
    <a class="btn btn-outline-secondary" asp-page="/Index">Back to main screen</a>
</section>
