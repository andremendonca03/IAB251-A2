@page
@model IndexModel
@{
    ViewData["Title"] = "Main screen";
}

<section class="entry-hero">
    <p class="eyebrow">AeroLink Ground Services</p>
    <h1>Welcome</h1>
    <p class="lead">
        Access essential ground services and manage your tasks efficiently.
        Explore real-time updates on turnaround operations, and ensure every task is completed on time.
    </p>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <a class="btn btn-accent" style="max-width: fit-content" asp-page="/Login">Sign in</a>
   
    }
</section>


@if (Model.BlockedModuleName is not null)
{
    @if (Model.BlockedModuleCause == "role")
    {
        <div class="alert gate-alert" role="alert">
            You can't access <strong>@Model.BlockedModuleName</strong>.
            Request access to this module with your Supervisor.
        </div>
    } else {
        <div class="alert gate-alert" role="alert">
            Sign in before opening <strong>@Model.BlockedModuleName</strong>.
            Operational information and module functions are unavailable until you have signed in.
        </div>
    }
}


@* Links use the cookie's department claim; page handlers enforce their own access rules. *@
<section class="module-board" aria-label="Operational modules">
    <div class="row g-4">
        @foreach (var module in Model.Modules)
        {
            <div class="col-md-4">
                <div class="module-card">
                    @if (User.Identity?.IsAuthenticated != true) {
                        <p class="lock-label">Sign-in required</p>
                    }

                    <h2>@module.Name</h2>
                    <p class="module-note">@module.Description</p>

                    @if (
                        // Logged In Operations User for Operations Module
                        User.Identity?.IsAuthenticated == true &&
                        User.FindFirst("DepartmentId")?.Value == "1" &&
                        @module.Key == "baggage"
                    ) {
                        <a class="btn btn-accent"
                        asp-page="@module.Link">Open module</a>
                    }

                    else if (
                        // Logged In Operations User for other Module
                        User.Identity?.IsAuthenticated == true &&
                        User.FindFirst("DepartmentId")?.Value == "1"
                    ) {
                        <a class="btn btn-outline-secondary"
                        asp-page="/Index"
                        asp-route-attempt="@module.Key"
                        asp-route-cause="role">Open module</a>
                    }

                    else if (
                        // Logged In User from other Department
                        User.Identity?.IsAuthenticated == true
                    ) {
                        <a class="btn btn-outline-secondary"
                        asp-page="">Open module</a>
                    }
                    
                    else {
                        <a class="btn btn-outline-secondary"
                        asp-page="/Index"
                        asp-route-attempt="@module.Key"
                        asp-route-cause="login">Open module</a>
                    }
                </div>
            </div>
        }
    </div>
</section>
