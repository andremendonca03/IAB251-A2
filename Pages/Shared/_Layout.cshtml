<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroLink</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AeroLink.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-sm">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <span class="navbar-brand-text"> <img src="~/images/aerolink-logo.svg" alt="AeroLink" width="32" height="32" /> </span>
                    AeroLink Ops Manager
                </a>
                <p class="navbar-text m-0 p-0">| &nbsp;@ViewData["Title"]</p>

                <div class="ms-auto d-flex align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Show user email and a Log Out button when logged in -->
                        <span class="text-white me-3 small d-none d-sm-inline">@User.Identity.Name</span>
                        <form method="post" asp-page="/Logout" class="m-0">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Log Out</button>
                        </form>
                    }
                    else if (ViewContext.RouteData.Values["page"]?.ToString() == "/Login")
                    {
                        <a class="btn btn-header" asp-page="/Index">Main screen</a>
                    }
                    else
                    {
                        <a class="btn btn-sign-in" asp-page="/Login">Sign in</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 AeroLink Ground Services
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>